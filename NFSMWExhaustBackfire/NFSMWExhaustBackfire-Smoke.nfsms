# NFSMW Exhaust Backfire v1.1.50 dedicated exhaust-vapor effect V7.
# Import once with NFS-VltEd after opening the Need for Speed Most Wanted game directory.
# The stock fxcar_exhaust_bmw records are not modified, so AI and other effects remain stock.
# V7 raises V6 density by 40% and particle size by 15%.

copy_node emitterdata emcar_exhaust_bmw default emcar_backfire_smoke_soft_v7_1
copy_node emitterdata emcar_exhaust_bmw2 default emcar_backfire_smoke_soft_v7_2

update_field emitterdata emcar_backfire_smoke_soft_v7_1 Life 0.5625
update_field emitterdata emcar_backfire_smoke_soft_v7_1 LifeVariance 0.0625
update_field emitterdata emcar_backfire_smoke_soft_v7_1 NumParticles 27
update_field emitterdata emcar_backfire_smoke_soft_v7_1 MotionInherit 0.90
update_field emitterdata emcar_backfire_smoke_soft_v7_1 IsOneShot true
update_field emitterdata emcar_backfire_smoke_soft_v7_1 OnCycle 0.12
update_field emitterdata emcar_backfire_smoke_soft_v7_1 OnCycleVariance 0
update_field emitterdata emcar_backfire_smoke_soft_v7_1 OffCycle 0
update_field emitterdata emcar_backfire_smoke_soft_v7_1 OffCycleVariance 0
update_field emitterdata emcar_backfire_smoke_soft_v7_1 Color1 3705857536
