# NFSMW Exhaust Backfire v1.1.47 dedicated exhaust-vapor effect V4.
# Import once with NFS-VltEd after opening the Need for Speed Most Wanted game directory.
# The stock fxcar_exhaust_bmw records are not modified, so AI and other effects remain stock.
# V4 restores a visible short puff while remaining isolated from V1/V2/V3 records.

copy_node emitterdata emcar_exhaust_bmw default emcar_backfire_smoke_soft_v4_1
copy_node emitterdata emcar_exhaust_bmw2 default emcar_backfire_smoke_soft_v4_2

update_field emitterdata emcar_backfire_smoke_soft_v4_1 Life 0.45
update_field emitterdata emcar_backfire_smoke_soft_v4_1 LifeVariance 0.05
update_field emitterdata emcar_backfire_smoke_soft_v4_1 NumParticles 16
update_field emitterdata emcar_backfire_smoke_soft_v4_1 MotionInherit 0.90
update_field emitterdata emcar_backfire_smoke_soft_v4_1 IsOneShot true
update_field emitterdata emcar_backfire_smoke_soft_v4_1 OnCycle 0.12
update_field emitterdata emcar_backfire_smoke_soft_v4_1 OnCycleVariance 0
update_field emitterdata emcar_backfire_smoke_soft_v4_1 OffCycle 0
update_field emitterdata emcar_backfire_smoke_soft_v4_1 OffCycleVariance 0
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Color1 3705857536
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Color2 3992122652
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Color3 3857378576
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Color4 3588088064
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Size X 0.336
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Size Y 0.54
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Size Z 0.90
update_field emitterdata emcar_backfire_smoke_soft_v4_1 Size W 1.26

update_field emitterdata emcar_backfire_smoke_soft_v4_2 Life 0.45
update_field emitterdata emcar_backfire_smoke_soft_v4_2 LifeVariance 0.05
update_field emitterdata emcar_backfire_smoke_soft_v4_2 NumParticles 16
